  "voice": {
    "$description": "Голос канала в Buzz. Правила: buzz/index.html#principles, #write, #dict, #emoji. Заготовки и проверка текста: buzz/assets/voice.js",
    "channel-name": "CVM B2B Делает",
    "address": "к читателю на «вы», о себе «мы»",
    "post": {
      "max-chars": 600,
      "paragraphs": "3-5",
      "max-emoji": 3,
      "max-exclamation": 1,
      "no-yo": "кроме «всё»",
      "no-em-dash": true,
      "no-trailing-period": "в конце абзаца, строки и блока точку не ставим, внутри абзаца ставим"
    },
